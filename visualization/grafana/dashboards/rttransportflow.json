{
  "uid": "rttf-main",
  "title": "rttransportflow \u2014 europe_mini",
  "timezone": "browser",
  "refresh": "2s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 6,
      "type": "timeseries",
      "title": "System frequency [Hz]",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "rttf-influx"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rothz",
          "min": 49.5,
          "max": 50.5,
          "decimals": 3,
          "custom": {
            "fillOpacity": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 49.9
              },
              {
                "color": "red",
                "value": 50.1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"rttf\")\n |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n |> filter(fn: (r) => r._measurement == \"freq\")\n |> filter(fn: (r) => r._field == \"f_hz\" or r._field == \"f_min_hz\" or r._field == \"f_max_hz\")\n |> keep(columns: [\"_time\", \"_field\", \"_value\"])"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Inertia H_sys [s] \u00b7 kinetic energy [GJ] \u00b7 RoCoF",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "rttf-influx"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"rttf\")\n |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n |> filter(fn: (r) => r._measurement == \"freq\")\n |> filter(fn: (r) => r._field == \"h_sys_s\" or r._field == \"rocof_max_hz_s\" or r._field == \"alert\")\n |> last()\n |> keep(columns: [\"_time\", \"_field\", \"_value\"])"
        }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "System power [MW]",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "rttf-influx"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "megwatt",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"rttf\")\n |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n |> filter(fn: (r) => r._measurement == \"summary\")\n |> filter(fn: (r) => r._field == \"load_mw\" or r._field == \"gen_mw\" or r._field == \"sgen_mw\" or r._field == \"slack_mw\" or r._field == \"loss_mw\")\n |> keep(columns: [\"_time\", \"_field\", \"_value\"])"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Simulation",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "rttf-influx"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"rttf\")\n |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n |> filter(fn: (r) => r._measurement == \"summary\")\n |> filter(fn: (r) => r._field == \"step\" or r._field == \"day\" or r._field == \"solve_ms\" or r._field == \"converged\")\n |> last()\n |> keep(columns: [\"_time\", \"_field\", \"_value\"])"
        }
      ]
    },
    {
