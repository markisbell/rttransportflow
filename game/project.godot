; Engine configuration file.

config_version=5

[application]

run/max_fps=60

config/name="rttransportflow"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

GameClock="*res://autoloads/game_clock.gd"
SidecarManager="*res://autoloads/sidecar_manager.gd"
CosimBridge="*res://autoloads/cosim_bridge.gd"
Boundary="*res://autoloads/boundary.gd"
Orchestrator="*res://autoloads/orchestrator.gd"
World="*res://model/world_model.gd"
Weather="*res://model/weather.gd"
Demand="*res://model/demand.gd"
Dispatch="*res://model/dispatch.gd"
Economy="*res://model/economy_books.gd"
BuildSession="*res://model/build_session.gd"
Campaign="*res://model/campaign.gd"
Sandbox="*res://model/sandbox.gd"
Scenario="*res://model/scenario.gd"
SaveLoad="*res://model/save_load.gd"
ZoneHistory="*res://model/zone_history.gd"
Restoration="*res://model/restoration.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[display]

window/size/viewport_width=1280
window/vsync/vsync_mode=0
window/size/viewport_height=800

[rendering]

textures/vram_compression/import_etc2_astc=true

; Forward+ for the infrastruct look: SSAO, soft shadows, filmic tonemap,
; sky ambient. Mobile falls back to the compatibility renderer.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
