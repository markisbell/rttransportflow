; Engine configuration file.

config_version=5

[application]

config/name="rttransportflow"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

GameClock="*res://autoloads/game_clock.gd"
SidecarManager="*res://autoloads/sidecar_manager.gd"
CosimBridge="*res://autoloads/cosim_bridge.gd"
Boundary="*res://autoloads/boundary.gd"
Orchestrator="*res://autoloads/orchestrator.gd"
World="*res://model/world_model.gd"
BuildSession="*res://model/build_session.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
