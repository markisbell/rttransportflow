# rttransportflow backend — every setting, with its default.
# Copy to .env and edit; env vars beat .env (pydantic-settings).

# --- service ---
#RTTRANSPORTFLOW_DATA_DIR=data/grids/europe_mini
#RTTRANSPORTFLOW_HOST=127.0.0.1          # loopback: the API has no auth
#RTTRANSPORTFLOW_PORT=8003               # family block: power 8000, heat 8001, water 8002
#RTTRANSPORTFLOW_LOG_LEVEL=info
#RTTRANSPORTFLOW_CORS_ORIGINS=[]

# --- clock ---
#RTTRANSPORTFLOW_STEP_INTERVAL_SECONDS=1.0
#RTTRANSPORTFLOW_STEPS_PER_DAY=96
#RTTRANSPORTFLOW_AUTOSTART=true
#RTTRANSPORTFLOW_EXTERNAL_CLOCK=false    # true = puppet mode (the game owns time)
#RTTRANSPORTFLOW_HISTORY_SIZE=512

# --- solver ---
#RTTRANSPORTFLOW_WARM_START=true

# --- dynamics (P2+; authority docs/PHYSICS.md §4) ---
#RTTRANSPORTFLOW_DT_ALERT=0.010
#RTTRANSPORTFLOW_DT_CALM=0.250
#RTTRANSPORTFLOW_PF_INTERVAL_ALERT=1.0
#RTTRANSPORTFLOW_PF_INTERVAL_CALM=30.0
#RTTRANSPORTFLOW_MAX_DT_S=900.0
#RTTRANSPORTFLOW_TRAJECTORY_MAX_SAMPLES=512
